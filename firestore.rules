rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. MonoUserProfile Validation
    function isValidMonoUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             data.currencyCode is string && data.currencyCode in ['USD', 'EUR', 'GBP', 'JPY', 'INR', 'KRW', 'CHF', 'CUSTOM'] &&
             data.customCurrencySymbol is string && data.customCurrencySymbol.size() >= 1 && data.customCurrencySymbol.size() <= 8 &&
             data.monthlyBudgetCents is int && data.monthlyBudgetCents >= 0 && data.monthlyBudgetCents <= 100000000000 &&
             data.reducedMotionEnabled is bool &&
             data.hapticsEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 2. MonoTransaction Validation
    function isValidMonoTransaction(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000000 &&
             data.type is string && data.type in ['EXPENSE', 'INCOME'] &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64 &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 64 &&
             data.timestampMillis is int && data.timestampMillis > 0 &&
             data.receiptNote is string && data.receiptNote.size() <= 500 &&
             data.isSplit is bool &&
             data.splitSummary is string && data.splitSummary.size() <= 500 &&
             data.isRecurringInstance is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 3. MonoCategoryBudget Validation
    function isValidMonoCategoryBudget(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64 &&
             data.categoryName is string && data.categoryName.size() >= 1 && data.categoryName.size() <= 64 &&
             data.limitCents is int && data.limitCents > 0 && data.limitCents <= 100000000000 &&
             data.alertThresholdPercent is int && data.alertThresholdPercent >= 10 && data.alertThresholdPercent <= 100 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 4. MonoSavingsGoal Validation
    function isValidMonoSavingsGoal(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.targetCents is int && data.targetCents > 0 && data.targetCents <= 100000000000 &&
             data.savedCents is int && data.savedCents >= 0 && data.savedCents <= 100000000000 &&
             data.deadlineMillis is int && data.deadlineMillis >= 0 &&
             data.accentHex is string && data.accentHex.size() >= 4 && data.accentHex.size() <= 12 &&
             data.isCompleted is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // 5. MonoRecurringBill Validation
    function isValidMonoRecurringBill(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.amountCents is int && data.amountCents > 0 && data.amountCents <= 100000000000 &&
             data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 64 &&
             data.cadence is string && data.cadence in ['MONTHLY', 'WEEKLY', 'YEARLY'] &&
             data.nextDueDayOfMonth is int && data.nextDueDayOfMonth >= 1 && data.nextDueDayOfMonth <= 31 &&
             data.isAutoRemind is bool &&
             data.lastPaidMonthKey is string && data.lastPaidMonthKey.size() <= 16 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // User-scoped collections
    match /users/{userId} {

      match /profile/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         incoming().keys().hasAll([
                           'userId', 'displayName', 'currencyCode', 'customCurrencySymbol',
                           'monthlyBudgetCents', 'reducedMotionEnabled', 'hapticsEnabled',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'displayName', 'currencyCode', 'customCurrencySymbol',
                           'monthlyBudgetCents', 'reducedMotionEnabled', 'hapticsEnabled',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonoUserProfile(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(docId) &&
                         isValidMonoUserProfile(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'currencyCode', 'customCurrencySymbol',
                           'monthlyBudgetCents', 'reducedMotionEnabled', 'hapticsEnabled',
                           'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      }

      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(transactionId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'amountCents', 'type', 'categoryId',
                           'categoryName', 'timestampMillis', 'receiptNote', 'isSplit',
                           'splitSummary', 'isRecurringInstance', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amountCents', 'type', 'categoryId',
                           'categoryName', 'timestampMillis', 'receiptNote', 'isSplit',
                           'splitSummary', 'isRecurringInstance', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonoTransaction(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(transactionId) &&
                         isValidMonoTransaction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amountCents', 'type', 'categoryId',
                           'categoryName', 'timestampMillis', 'receiptNote', 'isSplit',
                           'splitSummary', 'isRecurringInstance', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId) && existing().userId == request.auth.uid;
      }

      match /budgets/{budgetId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(budgetId) &&
                         incoming().keys().hasAll([
                           'userId', 'categoryId', 'categoryName', 'limitCents',
                           'alertThresholdPercent', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'categoryId', 'categoryName', 'limitCents',
                           'alertThresholdPercent', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonoCategoryBudget(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(budgetId) &&
                         isValidMonoCategoryBudget(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'categoryId', 'categoryName', 'limitCents',
                           'alertThresholdPercent', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(budgetId) && existing().userId == request.auth.uid;
      }

      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(goalId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(goalId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'targetCents', 'savedCents',
                           'deadlineMillis', 'accentHex', 'isCompleted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'targetCents', 'savedCents',
                           'deadlineMillis', 'accentHex', 'isCompleted',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonoSavingsGoal(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(goalId) &&
                         isValidMonoSavingsGoal(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'targetCents', 'savedCents',
                           'deadlineMillis', 'accentHex', 'isCompleted',
                           'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(goalId) && existing().userId == request.auth.uid;
      }

      match /bills/{billId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(billId) && (resource == null || existing().userId == request.auth.uid);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(billId) &&
                         incoming().keys().hasAll([
                           'userId', 'title', 'amountCents', 'categoryId',
                           'cadence', 'nextDueDayOfMonth', 'isAutoRemind',
                           'lastPaidMonthKey', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'title', 'amountCents', 'categoryId',
                           'cadence', 'nextDueDayOfMonth', 'isAutoRemind',
                           'lastPaidMonthKey', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidMonoRecurringBill(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(billId) &&
                         isValidMonoRecurringBill(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'amountCents', 'categoryId',
                           'cadence', 'nextDueDayOfMonth', 'isAutoRemind',
                           'lastPaidMonthKey', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(billId) && existing().userId == request.auth.uid;
      }
    }
  }
}
