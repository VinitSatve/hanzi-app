{
  "entities": {
    "MonoUserProfile": {
      "title": "MonoUserProfile",
      "description": "User financial preferences, currency settings, monthly budget limit, and motion/haptic accessibility controls.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "currencyCode": { "type": "string", "enum": ["USD", "EUR", "GBP", "JPY", "INR", "KRW", "CHF", "CUSTOM"] },
        "customCurrencySymbol": { "type": "string", "description": "Custom currency symbol when currencyCode is CUSTOM" },
        "monthlyBudgetCents": { "type": "integer", "description": "Monthly overall spending budget in cents" },
        "reducedMotionEnabled": { "type": "boolean", "description": "User override to reduce motion animations" },
        "hapticsEnabled": { "type": "boolean", "description": "User preference for tactile haptic feedback" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "displayName",
        "currencyCode",
        "customCurrencySymbol",
        "monthlyBudgetCents",
        "reducedMotionEnabled",
        "hapticsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonoTransaction": {
      "title": "MonoTransaction",
      "description": "An expense or income ledger entry supporting category attribution, receipt notes, and split breakdowns.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "title": { "type": "string", "description": "Merchant or transaction description" },
        "amountCents": { "type": "integer", "description": "Transaction value in cents (> 0)" },
        "type": { "type": "string", "enum": ["EXPENSE", "INCOME"] },
        "categoryId": { "type": "string", "description": "Category identifier" },
        "categoryName": { "type": "string", "description": "Display name of category" },
        "timestampMillis": { "type": "integer", "description": "Transaction occurrence epoch milliseconds" },
        "receiptNote": { "type": "string", "description": "Optional receipt memo or attachment note" },
        "isSplit": { "type": "boolean", "description": "Whether the transaction is split across participants or categories" },
        "splitSummary": { "type": "string", "description": "Compact formatted summary of split shares" },
        "isRecurringInstance": { "type": "boolean", "description": "Whether generated from a recurring subscription" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "title",
        "amountCents",
        "type",
        "categoryId",
        "categoryName",
        "timestampMillis",
        "receiptNote",
        "isSplit",
        "splitSummary",
        "isRecurringInstance",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonoCategoryBudget": {
      "title": "MonoCategoryBudget",
      "description": "Per-category monthly spending limit and warning threshold.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "categoryId": { "type": "string", "description": "Category key" },
        "categoryName": { "type": "string", "description": "Category label" },
        "limitCents": { "type": "integer", "description": "Monthly spending cap in cents" },
        "alertThresholdPercent": { "type": "integer", "description": "Alert percentage threshold (1-100)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "categoryId",
        "categoryName",
        "limitCents",
        "alertThresholdPercent",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonoSavingsGoal": {
      "title": "MonoSavingsGoal",
      "description": "Dedicated savings vault with target amount, current saved balance, and milestone tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "title": { "type": "string", "description": "Savings vault name" },
        "targetCents": { "type": "integer", "description": "Target savings goal in cents" },
        "savedCents": { "type": "integer", "description": "Current accumulated amount in cents" },
        "deadlineMillis": { "type": "integer", "description": "Target completion epoch milliseconds" },
        "accentHex": { "type": "string", "description": "Hex color tag for vault card" },
        "isCompleted": { "type": "boolean", "description": "Whether savedCents >= targetCents" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "title",
        "targetCents",
        "savedCents",
        "deadlineMillis",
        "accentHex",
        "isCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "MonoRecurringBill": {
      "title": "MonoRecurringBill",
      "description": "Recurring subscription or scheduled bill with due-day tracking and one-tap payment recording.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated Firebase UID" },
        "title": { "type": "string", "description": "Subscription or bill merchant name" },
        "amountCents": { "type": "integer", "description": "Recurring charge in cents" },
        "categoryId": { "type": "string", "description": "Associated category ID" },
        "cadence": { "type": "string", "enum": ["MONTHLY", "WEEKLY", "YEARLY"] },
        "nextDueDayOfMonth": { "type": "integer", "description": "Day of month bill is due (1-31)" },
        "isAutoRemind": { "type": "boolean", "description": "Whether to surface upcoming bill alerts" },
        "lastPaidMonthKey": { "type": "string", "description": "YYYY-MM marker of last recorded payment" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()" }
      },
      "required": [
        "userId",
        "title",
        "amountCents",
        "categoryId",
        "cadence",
        "nextDueDayOfMonth",
        "isAutoRemind",
        "lastPaidMonthKey",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile/{docId}": {
      "schema": { "$ref": "#/entities/MonoUserProfile" },
      "description": "User financial settings and preferences document (docId = settings)"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/MonoTransaction" },
      "description": "Per-user expense and income transactions"
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/MonoCategoryBudget" },
      "description": "Per-user category spending budgets"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/MonoSavingsGoal" },
      "description": "Per-user savings vaults and milestones"
    },
    "/users/{userId}/bills/{billId}": {
      "schema": { "$ref": "#/entities/MonoRecurringBill" },
      "description": "Per-user recurring bills and subscriptions"
    }
  }
}
